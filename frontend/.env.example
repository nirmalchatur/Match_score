# Base URL for the Django REST API.
#
# LOCAL DEVELOPMENT
# Leave this unset. The Vite dev proxy forwards /api -> http://127.0.0.1:8000,
# so no CORS setup is needed locally.
#
# DEPLOYMENT
# Set this to your deployed backend's public URL, including the /api prefix.
# In Vercel: Project Settings > Environment Variables > VITE_API_URL
#
#   VITE_API_URL=https://tailorup-api.onrender.com/api
#
# The trailing /api is required — the client appends /auth/me/, /jobs/, etc.
VITE_API_URL=

# Copy to .env and adjust. Never commit a real .env.

# --- Django ----------------------------------------------------------------
DEBUG=1
SECRET_KEY=change-me-in-production
# Comma-separated. Leave unset to use the local defaults in settings.py.
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# Leave unset for local SQLite. Set this in production (Render, Railway, ...).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- AI provider -----------------------------------------------------------
# Which provider tailors resumes. "ollama" for a local daemon, "fake" for a
# deterministic in-process double with no network (used by the test suite).
#
# Leave empty to disable tailoring entirely: the UI then explains that no
# provider is configured instead of failing on click.
AI_PROVIDER=

# Local Ollama daemon. Both values are required for the implicit "ollama"
# default; see docs/AI_SETUP.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Seconds to wait. Local models are slow on a cold start, especially on CPU.
OLLAMA_TIMEOUT=180

# Keep this low: tailoring must stay close to the source text, not improvise.
OLLAMA_TEMPERATURE=0.2

# --- Document generation ----------------------------------------------------
# No configuration is required. DOCX and PDF are rendered on demand from the
# validated structured resume by deterministic code (python-docx and reportlab);
# no model and no external binary is involved.
#
# Documents are generated per request rather than cached on disk, so a stored
# file can never go stale after an edit.

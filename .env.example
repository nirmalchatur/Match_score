# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# Generated from backend/config/settings.py -- every variable below is read
# by that file. Defaults in the comment are what the code uses if you set
# nothing.
# ---------------------------------------------------------------------------

# --- Core Django -----------------------------------------------------------
# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-real-one

# False in any deployed environment. The deploy policy job fails the build if
# this is True, because DEBUG=True serves tracebacks containing settings and
# source to any visitor.
DEBUG=True

# Comma-separated. Required when DEBUG is False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL in production; omit to use SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Frontend (Vite) --------------------------------------------------------
# Inlined into the bundle at BUILD time and readable in devtools. Never put a
# secret in a VITE_ variable. Vite only exposes variables with this prefix to
# client code, so renaming one to VITE_* would publish it.
VITE_API_URL=http://127.0.0.1:8000

# --- CORS ------------------------------------------------------------------
# The deployed frontend origin, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_REGEX=

# --- AI provider -----------------------------------------------------------
# One of: ollama, gemini. Defaults to ollama only when both OLLAMA_* are set.
AI_PROVIDER=

# Local Ollama. No key needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# A real tailoring call to llama3.1 on CPU took 364s, so the 180s default will
# time out on a machine without a GPU. Raise this for a self-hosted daemon.
# 180 is fine on hardware-accelerated inference, which is typically under 30s.
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.2

# Hosted Gemini. Bring-your-own-key: users paste their own key in Settings and
# it is encrypted at rest. There is deliberately no server-wide key, so a
# deployment can never spend the owner's quota on someone else's behalf.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=120
GEMINI_TEMPERATURE=0.2

# --- Email -----------------------------------------------------------------
# TailorUp sends no email today. SMTP is used automatically when DEBUG is
# False; set these only if a password-reset flow is added.
EMAIL_BACKEND=
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=

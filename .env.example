# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# Generated from backend/config/settings.py -- every variable below is read
# by that file. Defaults in the comment are what the code uses if you set
# nothing.
# ---------------------------------------------------------------------------

# --- Core Django -----------------------------------------------------------
# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me-generate-a-real-one

# False in any deployed environment. The deploy policy job fails the build if
# this is True, because DEBUG=True serves tracebacks containing settings and
# source to any visitor.
DEBUG=True

# Comma-separated. Required when DEBUG is False.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# PostgreSQL in production; omit to use SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Frontend (Vite) --------------------------------------------------------
# Inlined into the bundle at BUILD time and readable in devtools. Never put a
# secret in a VITE_ variable. Vite only exposes variables with this prefix to
# client code, so renaming one to VITE_* would publish it.
VITE_API_URL=http://127.0.0.1:8000

# --- CORS ------------------------------------------------------------------
# The deployed frontend origin, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_REGEX=

# --- AI provider -----------------------------------------------------------
# One of: ollama, gemini, groq. Defaults to ollama when OLLAMA_* are set, and
# otherwise to whichever hosted provider has a key below.
AI_PROVIDER=

# Local Ollama. No key needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
# A real llama3.1 tailoring call on CPU-only hardware took 364s, so the default
# is 600, not 180. At 180 the request aborts mid-generation and the user sees a
# timeout instead of a result. Raise this for a larger model or a slower machine.
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.2

# --- Hosted providers ------------------------------------------------------
# *_API_KEY is an OPTIONAL DEPLOYMENT FALLBACK, used only when the signed-in
# user has saved no key of their own. Users who paste their own key always have
# that one used instead; it is stored encrypted and deleted on sign-out.
#
# Leaving both blank keeps the app strictly bring-your-own-key: nobody's
# tailoring runs on anyone else's quota. Setting one means the owner's quota
# pays for every user who did not bring a key.

# Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=120
GEMINI_TEMPERATURE=0.2

# Groq (OpenAI-compatible). Considerably faster than the free Gemini tier for
# the same work; set AI_PROVIDER=groq to prefer it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=120
GROQ_TEMPERATURE=0.2

# --- Email -----------------------------------------------------------------
# TailorUp sends no email today. SMTP is used automatically when DEBUG is
# False; set these only if a password-reset flow is added.
EMAIL_BACKEND=
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=
SMTP_PASSWORD=
